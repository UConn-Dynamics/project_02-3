    ṡ1_arr = s1_vel.(θ_arr, ω₃)
    ṡ2_arr = s2_vel.(θ_arr, ω₃)

    # ── Accelerations ──────────────────────────────────────────────────────────
    ẍc_arr = xc_acc.(θ_arr, ω₃, α₃)
    ÿc_arr = yc_acc.(θ_arr, ω₃, α₃)
