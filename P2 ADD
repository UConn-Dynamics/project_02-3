# ╔═╡ a1000000-0000-0000-0000-000000000018
md"""
---
## Verification — Jacobian vs Analytical

Check that the numerical Jacobian method gives the same velocities and accelerations
as the analytical formulas.
"""

# ╔═╡ a1000000-0000-0000-0000-000000000019
let
    err_v = Float64[]
    err_a = Float64[]
    for θ in θ_arr
        v_num = solve_velocities(θ, ω₃)
        v_ana = [xc_vel(θ, ω₃), yc_vel(θ, ω₃)]
        push!(err_v, norm(v_num .- v_ana))

        a_num = solve_accelerations(θ, ω₃, α₃, xc_vel(θ,ω₃), yc_vel(θ,ω₃))
        a_ana = [xc_acc(θ, ω₃, α₃), yc_acc(θ, ω₃, α₃)]
        push!(err_a, norm(a_num .- a_ana))
    end
    md"""
    | Quantity | Max error |
    |----------|-----------|
    | Velocity | $(round(maximum(err_v), sigdigits=3)) m/s |
    | Acceleration | $(round(maximum(err_a), sigdigits=3)) m/s² |

    Errors are due to floating-point round-off only — methods agree. ✓
    """
end

